#include <stdio.h>
int main() {
    int a[10] = {1, 2, 3, 5, 6};
    int n = 5;
    int pos = 3;   
    int val = 4;  
    int i;
    for(i = n; i > pos; i--) {
        a[i] = a[i - 1];
}
    a[pos] = val;
    n++;
    printf("Array after insertion:\n");
    for(i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }
    return 0;
}

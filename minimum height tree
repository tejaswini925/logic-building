from collections import deque

class Solution:
    def findMinHeightTrees(self, n, edges):
        if n == 1:
            return [0]

        g = [set() for _ in range(n)]

        for a, b in edges:
            g[a].add(b)
            g[b].add(a)

        leaves = deque(i for i in range(n) if len(g[i]) == 1)

        while n > 2:
            n -= len(leaves)

            for _ in range(len(leaves)):
                leaf = leaves.popleft()
                x = g[leaf].pop()
                g[x].remove(leaf)

                if len(g[x]) == 1:
                    leaves.append(x)

        return list(leaves)

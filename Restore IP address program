#include <stdio.h>
#include <string.h>
int main()
{
    char s[20];
    int i,j,k,n;
    printf("Enter digits: ");
    scanf("%s",s);
    n = strlen(s);
    for(i=1;i<=3;i++)
    for(j=1;j<=3;j++)
    for(k=1;k<=3;k++)
    {
        int l = n - (i+j+k);
        if(l>=1 && l<=3)
        {
            printf("%.*s.%.*s.%.*s.%.*s\n",
            i,s,
            j,s+i,
            k,s+i+j,
            l,s+i+j+k);
        }
    }
}

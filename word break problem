#include<stdio.h>
#include<stdbool.h>
bool startsWith(char*s,char*word)
{
return strncmp(s,word,strlen(word))==0;
}
bool wordBreak(char*s,char dict[][20],int size)
{
if(strlen(s)==0)
return true;
for(int i=0;i<size;i++)
{
if(startsWith(s,dict[i]))
{
if(wordBreak(s+strlen(dict[i],dict,size))
return true;
}
}
return false;
}
void main()
{
char s[]="leetcode";
char dict[][20]={"leet","code"};
if(wordBreak(s,dict,2))
printf("yes\n");
else
printf("no\n");
}

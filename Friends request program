#include <stdio.h>
int main() {
    int req[] = {1,1,2};
    int acc[] = {2,3,3};
    int count[10] = {0};
    for(int i=0;i<3;i++){
        count[req[i]]++;
        count[acc[i]]++;
    }
    int max=0,id=0;
    for(int i=1;i<10;i++)
        if(count[i]>max){
            max=count[i];
            id=i;
        }
    printf("ID=%d Friends=%d", id, max);
}

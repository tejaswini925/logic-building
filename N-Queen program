n = 4
board = [-1] * n

def is_safe(row, col):
    for i in range(row):
        if board[i] == col or abs(board[i] - col) == abs(i - row):
            return False
    return True

def solve(row):
    if row == n:
        print(board)
        print_board()
        return
    
    for col in range(n):
        if is_safe(row, col):
            board[row] = col
            solve(row + 1)

def print_board():
    for i in range(n):
        for j in range(n):
            if board[i] == j:
                print("Q", end=" ")
            else:
                print(".", end=" ")
        print()
    print()

solve(0)

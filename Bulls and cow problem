#include <stdio.h>
int main() {
    char s[] = "1807", g[] = "7810";
    int b = 0, c = 0, a[10] = {0};
    for(int i = 0; s[i]; i++) {
        if(s[i] == g[i]) b++;
        else {
            if(a[s[i]-'0'] < 0) c++;
            if(a[g[i]-'0'] > 0) c++;
            a[s[i]-'0']++;
            a[g[i]-'0']--;
        }
    }
    printf("%dA%dB", b, c);
    return 0;
}

#include <stdio.h>
int main()
{
    int n,i;
    printf("Enter number of children: ");
    scanf("%d",&n);
    int r[n],c[n];
    printf("Enter ratings:\n");
    for(i=0;i<n;i++)
    {
        scanf("%d",&r[i]);
        c[i]=1;   
    }
    for(i=1;i<n;i++)
    {
        if(r[i] > r[i-1])
            c[i] = c[i-1] + 1;
    }
    for(i=n-2;i>=0;i--)
    {
        if(r[i] > r[i+1] && c[i] <= c[i+1])
            c[i] = c[i+1] + 1;
    }
    int sum=0;
    for(i=0;i<n;i++)
        sum += c[i];
    printf("Minimum candies = %d",sum);
    return 0;
}

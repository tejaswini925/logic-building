#include <stdio.h>
#include <stdbool.h>
bool hasPeak(int arr[], int n) {
    for (int i = 0; i < n; i++) {
        if ((i == 0 || arr[i] >= arr[i-1]) &&
            (i == n-1 || arr[i] >= arr[i+1])) {
            return true;  // peak found
        }
    }
    return false;
}

int main() {
    int n;
    printf("Enter number of elements: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter elements:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    if (hasPeak(arr, n))
        printf("true");
    else
        printf("false");
    return 0;
}

#include <stdio.h>
#include <math.h>
int main() {
    int x[] = {0,1,2}, y[] = {0,1,2};
    int n = 3;
    float min = 1e9;
    for(int i=0;i<n;i++)
        for(int j=i+1;j<n;j++) {
            float d = sqrt((x[i]-x[j])*(x[i]-x[j]) +
                           (y[i]-y[j])*(y[i]-y[j]));
            if(d < min) min = d;
        }
    printf("%.2f", min);
}

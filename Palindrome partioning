class Solution:
    def partition(self, s):
        res = []

        def dfs(i, path):
            if i == len(s):
                res.append(path)
                return

            for j in range(i + 1, len(s) + 1):
                t = s[i:j]
                if t == t[::-1]:
                    dfs(j, path + [t])

        dfs(0, [])
        return res

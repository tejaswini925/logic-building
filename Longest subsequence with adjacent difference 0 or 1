#include <stdio.h>
#include <stdlib.h>
int longestSubsequence(int arr[], int n)
{
    int dp[n];
    int max = 1;
    for (int i = 0; i < n; i++)
        dp[i] = 1;
    for (int i = 1; i < n; i++)
    {
        for (int j = 0; j < i; j++)
        {
            if (abs(arr[i] - arr[j]) <= 1 && dp[i] < dp[j] + 1)
            {
                dp[i] = dp[j] + 1;
            }
        }
        if (dp[i] > max)
            max = dp[i];
    }
    return max;
}
int main()
{
    int arr[] = {1, 2, 2, 3, 1, 2};
    int n = sizeof(arr) / sizeof(arr[0]);
    printf("Longest subsequence length = %d", longestSubsequence(arr, n));
    return 0;
}

#include<stdio.h>
void print(int a[3][3])
{
for(int i=0;i<3;i++)
{
for(int j=0;j<3;j++)
printf("%d",a[i][j]);
printf("\n");
}
printf("\n");
}
void main()
{
int a[3][3]={
{2,3,4},
{4,0,5},
{8,4,6},
};
printf("start state\n");
print(a);
a[1][1]=5;
a[1][2]=0;
printf("after move 1\n");
print(a);
a[1][2]=6;
a[2][2]=0;
printf("goal state reached\n");
print(a);
}

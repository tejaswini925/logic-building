class Solution:
    def reverseKGroup(self, head, k):
        cur = head
        count = 0

        while cur and count < k:
            cur = cur.next
            count += 1

        if count < k:
            return head

        cur = head
        prev = None

        for _ in range(k):
            nxt = cur.next
            cur.next = prev
            prev = cur
            cur = nxt

        head.next = self.reverseKGroup(cur, k)
        return prev

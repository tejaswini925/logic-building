#include <stdio.h>
#include <stdbool.h>
int start[1000], end[1000];
int size = 0;
bool book(int s, int e) {
    for(int i = 0; i < size; i++) {
        if(s < end[i] && e > start[i])  
            return false;
    }
    start[size] = s;
    end[size] = e;
    size++;
    return true;
}
int main() {
    printf("%d\n", book(10, 20)); // 1 (true)
    printf("%d\n", book(15, 25)); // 0 (false)
    printf("%d\n", book(20, 30)); // 1 (true)
    return 0;
}

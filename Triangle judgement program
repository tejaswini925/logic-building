def triangleJudgement(data):

    result = []

    for x, y, z in data:

        if (x + y > z and
            x + z > y and
            y + z > x):

            result.append([x, y, z, "Yes"])

        else:
            result.append([x, y, z, "No"])

    return result


data = [
    [13, 15, 30],
    [10, 20, 15]
]

print(triangleJudgement(data))

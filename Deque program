#include <stdio.h>
#define MAX 5
int d[MAX], f = -1, r = -1;
void insertFront(int x) {
    if (f == 0) {
        printf("Front full\n");
        return;
    }
    if (f == -1) f = r = 0;
    else f--;
    d[f] = x;
}
void insertRear(int x) {
    if (r == MAX - 1) {
        printf("Rear full\n");
        return;
    }
    if (r == -1) f = r = 0;
    else r++;
    d[r] = x;
}
void deleteFront() {
    if (f == -1) {
        printf("Deque empty\n");
        return;
    }
    printf("Deleted from front: %d\n", d[f]);
    if (f == r) f = r = -1;
    else f++;
}
void deleteRear() {
    if (r == -1) {
        printf("Deque empty\n");
        return;
    }
    printf("Deleted from rear: %d\n", d[r]);
    if (f == r) f = r = -1;
    else r--;
}
void display() {
    if (f == -1) {
        printf("Deque empty\n");
        return;
    }
    for (int i = f; i <= r; i++)
        printf("%d ", d[i]);
    printf("\n");
}
int main() {
    insertRear(10);
    insertRear(20);
    insertFront(5);
    display();
    deleteFront();
    deleteRear();
    display();
    return 0;
}

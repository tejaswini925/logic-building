#include <stdio.h>
int count = 0;
void f(int n, int pos, int a[]) {
    if (pos > n) {
        count++;
        return;
    }
    for (int i = 1; i <= n; i++) {
        if (a[i] == 0 && (i % pos == 0 || pos % i == 0)) {
            a[i] = 1;
            f(n, pos + 1, a);
            a[i] = 0;
        }
    }
}
int main() {
    int n = 3;
    int a[20] = {0};
    f(n, 1, a);
    printf("%d", count);
}

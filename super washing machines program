def findMinMoves(machines):
    total = sum(machines)
    n = len(machines)

    # Not possible case
    if total % n != 0:
        return -1

    target = total // n
    balance = 0
    moves = 0

    for m in machines:
        diff = m - target
        balance += diff
        moves = max(moves, abs(balance), diff)

    return moves

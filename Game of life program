#include <stdio.h>
int main()
{
    int a[3][3] = {
        {0,1,0},
        {1,1,0},
        {0,0,1}
    };
    int b[3][3];
    int i,j,n;
    for(i=0;i<3;i++)
    {
        for(j=0;j<3;j++)
        {
            n = 0;
            if(i>0 && a[i-1][j]==1) n++;
            if(i<2 && a[i+1][j]==1) n++;
            if(j>0 && a[i][j-1]==1) n++;
            if(j<2 && a[i][j+1]==1) n++;
            if(a[i][j]==1 && (n==2 || n==3))
                b[i][j]=1;
            else if(a[i][j]==0 && n==3)
                b[i][j]=1;
            else
                b[i][j]=0;
        }
    }
    printf("Next Generation:\n");
    for(i=0;i<3;i++)
    {
        for(j=0;j<3;j++)
            printf("%d ",b[i][j]);
        printf("\n");
    }
    return 0;
}

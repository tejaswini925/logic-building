class Solution:
    def isInterleave(self, s1, s2, s3):
        if len(s1) + len(s2) != len(s3):
            return False

        dp = {(0, 0)}

        for k in range(len(s3)):
            ndp = set()

            for i, j in dp:
                if i < len(s1) and s1[i] == s3[k]:
                    ndp.add((i + 1, j))

                if j < len(s2) and s2[j] == s3[k]:
                    ndp.add((i, j + 1))

            dp = ndp

        return (len(s1), len(s2)) in dp

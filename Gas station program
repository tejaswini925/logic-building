#include <stdio.h>
int main() {
    int gas[] = {1, 2, 3, 4, 5};
    int cost[] = {3, 4, 5, 1, 2};
    int n = 5;
    int total_gas = 0, total_cost = 0;
    int tank = 0, start = 0;
    for (int i = 0; i < n; i++) {
        total_gas += gas[i];
        total_cost += cost[i];
        tank = tank + (gas[i] - cost[i]);
        if (tank < 0) {
            start = i + 1;
            tank = 0;
        }
    }
    if (total_gas < total_cost) {
        printf("-1");
    } else {
        printf("%d", start);
    }
    return 0;
}

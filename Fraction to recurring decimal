class Solution:
    def fractionToDecimal(self, numerator, denominator):
        if numerator == 0:
            return "0"

        sign = "-" if (numerator < 0) != (denominator < 0) else ""
        a, b = abs(numerator), abs(denominator)

        ans = sign + str(a // b)
        r = a % b

        if r == 0:
            return ans

        ans += "."

        seen = {}
        while r:
            if r in seen:
                i = seen[r]
                ans = ans[:i] + "(" + ans[i:] + ")"
                break

            seen[r] = len(ans)
            r *= 10
            ans += str(r // b)
            r %= b

        return ans

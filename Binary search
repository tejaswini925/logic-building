#include<stdio.h>
void main()
{
int a[10],i,n,low,high,mid,key;
printf("enter the number of elements\n");
scanf("%d",&n);
printf("enter the elements in sorted order\n",n);
for(i=1;i<=n;i++)
scanf("%d",&a[i]);
printf("1-d array elements\n");
for(i=1;i<=n;i++)
printf("%d\n",a[i]);
printf("enter the key elements to be searched\n");
scanf("%d",&key);
low=1;
high=n;
while(low<=high)
{
mid=(low+high)/2;
if(key==a[mid]);
{
printf("%d found at %d position\n",key,mid);
return;
}
if(key<a[mid])
high=mid-1;
if(key>a[mid])
low=mid+1;
}
printf("%d not found\n",key);
}

class Solution:
    def nthSuperUglyNumber(self, n, primes):
        dp = [1] * n
        index = [0] * len(primes)

        for i in range(1, n):
            dp[i] = min(primes[j] * dp[index[j]]
                        for j in range(len(primes)))

            for j in range(len(primes)):
                if primes[j] * dp[index[j]] == dp[i]:
                    index[j] += 1

        return dp[-1]

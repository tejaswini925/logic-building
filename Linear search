#include<stdio.h>
void main()
{
int a[10],i,n,key,pos,flag=0;
printf("enter the number of elements\n");
scanf("%d",&n);
printf("enter %d elements\n");
for(i=1;i<=n;i++)
scanf("%d",&a[i]);
printf("enter key elements to be searched\n");
scanf("%d",&key);
for(i=1;i<=n;i++)
{
if(key==a[i])
{
pos=i;
flag=1;
break;
}
}
if(flag)
printf("%d found at %d position\n",key,pos);
else
printf("%d not found\n",key);
}

#include <stdio.h>

int tree[20];   // Array to store tree
int n;

int main() {
    int i;

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    printf("Enter tree elements:\n");
    for (i = 1; i <= n; i++) {
        scanf("%d", &tree[i]);
    }

    printf("\nArray Representation of Tree:\n");
    for (i = 1; i <= n; i++) {
        printf("Index %d -> %d\n", i, tree[i]);
    }

    printf("\nTree Structure (Index wise):\n");
    for (i = 1; i <= n / 2; i++) {
        if (2 * i <= n)
            printf("Parent %d -> Left Child %d\n", tree[i], tree[2 * i]);
        if (2 * i + 1 <= n)
            printf("Parent %d -> Right Child %d\n", tree[i], tree[2 * i + 1]);
    }

    return 0;
}

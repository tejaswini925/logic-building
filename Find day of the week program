#include <stdio.h>
int main() {
    int day, month, year;
    int q, m, K, J, h;
    scanf("%d %d %d", &day, &month, &year);
    q = day;
    if (month == 1) {
        m = 13;
        year--;
    } 
    else if (month == 2) {
        m = 14;
        year--;
    } 
    else {
        m = month;
    }
    K = year % 100;
    J = year / 100;
    h = (q + (13 * (m + 1)) / 5 + K + (K / 4) + (J / 4) + (5 * J)) % 7;
    printf("%d", h);
    return 0;
}

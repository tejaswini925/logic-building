#include<stdio.h>
int main()
{
    int h[50], n, i, j;
    int leftmax, rightmax, water = 0;
    printf("Enter number of bars: ");
    scanf("%d",&n);
    printf("Enter heights:\n");
    for(i=0;i<n;i++)
        scanf("%d",&h[i]);
    for(i=0;i<n;i++)
    {
        leftmax = h[i];
        for(j=0;j<=i;j++)
        {
            if(h[j] > leftmax)
                leftmax = h[j];
        }
        rightmax = h[i];
        for(j=i;j<n;j++)
        {
            if(h[j] > rightmax)
                rightmax = h[j];
        }
        if(leftmax < rightmax)
            water += leftmax - h[i];
        else
            water += rightmax - h[i];
    }
    printf("Water trapped = %d", water);
    return 0;
}

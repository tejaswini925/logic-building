#include <stdio.h>
void pourWater(int h[], int n, int V, int K) {
    while(V--) {
        int pos = K;
        for(int i = K - 1; i >= 0; i--) {
            if(h[i] > h[pos]) break;
            if(h[i] < h[pos]) pos = i;
        }
        if(pos != K) {
            h[pos]++;
            continue;
        }
        for(int i = K + 1; i < n; i++) {
            if(h[i] > h[pos]) break;
            if(h[i] < h[pos]) pos = i;
        }

        h[pos]++;
    }
}
int main() {
    int h[] = {2,1,1,2,1,2,2};
    int n = 7, V = 4, K = 2;
    pourWater(h, n, V, K);
    for(int i=0;i<n;i++)
        printf("%d ", h[i]);
    return 0;
}

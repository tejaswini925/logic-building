class Solution:
    def divide(self, dividend, divisor):
        if dividend == -2**31 and divisor == -1:
            return 2**31 - 1

        a, b = abs(dividend), abs(divisor)
        ans = 0

        while a >= b:
            temp, count = b, 1
            while a >= temp + temp:
                temp += temp
                count += count
            a -= temp
            ans += count

        if (dividend < 0) != (divisor < 0):
            ans = -ans

        return ans

class Solution:
    def letterCombinations(self, digits):
        if not digits:
            return []

        d = {
            '2': 'abc', '3': 'def', '4': 'ghi',
            '5': 'jkl', '6': 'mno', '7': 'pqrs',
            '8': 'tuv', '9': 'wxyz'
        }

        ans = ['']

        for digit in digits:
            ans = [s + c for s in ans for c in d[digit]]

        return ans

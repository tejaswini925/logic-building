#include<stdio.h>
int main()
{
    int n;
    char s[100];
    int i=0;
    printf("Enter column number: ");
    scanf("%d",&n);
    while(n>0)
    {
        n--;                 
        s[i] = 'A' + (n % 26);
        i++;
        n = n / 26;
    }
    printf("Column title: ");
    for(int j=i-1;j>=0;j--)
        printf("%c",s[j]);
    return 0;
}

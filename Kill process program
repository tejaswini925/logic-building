#include <stdio.h>
int main() {
    int pid[] = {1,3,10,5};
    int ppid[] = {3,0,5,3};
    int n = 4, kill = 5;
    int q[100], front = 0, rear = 0;
    q[rear++] = kill;
    while (front < rear) {
        int cur = q[front++];
        printf("%d ", cur);
        for (int i = 0; i < n; i++)
            if (ppid[i] == cur)
                q[rear++] = pid[i];
    }
}

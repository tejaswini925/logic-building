import math

def shortestDistance(points):

    min_distance = float('inf')

    n = len(points)

    for i in range(n):

        for j in range(i + 1, n):

            x1, y1 = points[i]
            x2, y2 = points[j]

            distance = math.sqrt((x2 - x1)**2 + (y2 - y1)**2)

            min_distance = min(min_distance, distance)

    return round(min_distance, 2)

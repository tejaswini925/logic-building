#include<stdio.h>
int max(int a,int b)
{
    if(a>b)
        return a;
    else
        return b;
}
int main()
{
    int a[100],dp[100];
    int n,i;
    printf("Enter number of houses: ");
    scanf("%d",&n);
    printf("Enter money in houses:\n");
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);
    dp[0]=a[0];
    dp[1]=max(a[0],a[1]);
    for(i=2;i<n;i++)
        dp[i]=max(dp[i-1], a[i]+dp[i-2]);
    printf("Maximum money robbed = %d",dp[n-1]);
    return 0;
}

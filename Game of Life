class Solution:
    def gameOfLife(self, b):
        m,n=len(b),len(b[0])
        c=[r[:] for r in b]
        for i in range(m):
            for j in range(n):
                s=sum(c[x][y] for x in range(max(0,i-1),min(m,i+2))
                               for y in range(max(0,j-1),min(n,j+2)))-(c[i][j])
                b[i][j]=1 if s==3 or (c[i][j] and s==2) else 0

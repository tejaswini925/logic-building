#include <stdio.h>
#define MAX 100000
int longestConsecutive(int arr[], int n)
{
int hash[MAX] = {0};  
int i, longest = 0;
    for (i = 0; i < n; i++)
        hash[arr[i]] = 1;
    for (i = 0; i < n; i++)
    {
        if (hash[arr[i] - 1] == 0)
        {
            int current = arr[i];
            int count = 1;

            while (hash[current + 1] == 1)
            {
                current++;
                count++;
            }

            if (count > longest)
                longest = count;
        }
    }
return longest;
}
int main()
{
int arr[] = {100, 4, 200, 1, 3, 2};
int n = sizeof(arr) / sizeof(arr[0]);
printf("Longest consecutive sequence length = %d",longestConsecutive(arr, n));
return 0;
}

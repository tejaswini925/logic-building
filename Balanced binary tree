class Solution:
    def isBalanced(self, root):
        def h(node):
            if not node:
                return 0
            l = h(node.left)
            r = h(node.right)
            if l == -1 or r == -1 or abs(l-r) > 1:
                return -1
            return max(l, r) + 1
        return h(root) != -1

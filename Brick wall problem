from collections import defaultdict

class Solution:
    def leastBricks(self, wall):
        edge_count = defaultdict(int)

        for row in wall:
            pos = 0
            # skip last brick
            for brick in row[:-1]:
                pos += brick
                edge_count[pos] += 1

        max_edges = max(edge_count.values(), default=0)
        return len(wall) - max_edges

class Solution:
    def maximalRectangle(self, matrix):
        if not matrix:
            return 0

        cols = len(matrix[0])
        heights = [0] * (cols + 1)
        maximum = 0

        for row in matrix:
            for j in range(cols):
                if row[j] == '1':
                    heights[j] += 1
                else:
                    heights[j] = 0

            stack = []
            for j in range(cols + 1):
                while stack and heights[stack[-1]] > heights[j]:
                    h = heights[stack.pop()]
                    width = j if not stack else j - stack[-1] - 1
                    maximum = max(maximum, h * width)

                stack.append(j)

        return maximum

#include <stdio.h>
int nthSuperUglyNumber(int n, int* primes, int primesSize) {
    int ugly[n], idx[primesSize];
    for(int i=0;i<primesSize;i++)
        idx[i] = 0;
    ugly[0] = 1;
    for(int i=1;i<n;i++) {
        int min = 1e9;
        for(int j=0;j<primesSize;j++) {
            int val = primes[j] * ugly[idx[j]];
            if(val < min) min = val;
        }
        ugly[i] = min;
        for(int j=0;j<primesSize;j++) {
            if(primes[j] * ugly[idx[j]] == min)
                idx[j]++;
        }
    }
    return ugly[n-1];
}

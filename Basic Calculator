class Solution:
    def calculate(self, s):
        stack = [0]
        sign = 1
        num = 0
        ans = 0

        for c in s + '+':
            if c.isdigit():
                num = num * 10 + int(c)
            elif c in '+-':
                ans += sign * num
                num = 0
                sign = 1 if c == '+' else -1
            elif c == '(':
                stack.append(ans)
                stack.append(sign)
                ans = 0
                sign = 1
            elif c == ')':
                ans += sign * num
                num = 0
                ans *= stack.pop()
                ans += stack.pop()

        return ans

class Solution:
    def addOperators(self, num, target):
        ans = []

        def dfs(i, expr, value, prev):
            if i == len(num):
                if value == target:
                    ans.append(expr)
                return

            for j in range(i, len(num)):
                if j > i and num[i] == '0':
                    break

                s = num[i:j + 1]
                n = int(s)

                if i == 0:
                    dfs(j + 1, s, n, n)
                else:
                    dfs(j + 1, expr + "+" + s, value + n, n)
                    dfs(j + 1, expr + "-" + s, value - n, -n)
                    dfs(j + 1, expr + "*" + s,
                        value - prev + prev * n, prev * n)

        dfs(0, "", 0, 0)
        return ans

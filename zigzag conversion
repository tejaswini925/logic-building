#include <stdio.h>
#include <string.h>
int main() {
    char str[100];
    int rows;
    printf("Enter string: ");
    scanf("%s", str);
    printf("Enter number of rows: ");
    scanf("%d", &rows);
    int len = strlen(str);
    if(rows == 1) {
        printf("Output: %s", str);
        return 0;
    }
    char arr[20][100];   
    int i;
    for(i = 0; i < rows; i++)
        arr[i][0] = '\0';
    int row = 0;
    int direction = 1;   // 1 = down, -1 = up
    for(i = 0; i < len; i++) {
        int l = strlen(arr[row]);
        arr[row][l] = str[i];
        arr[row][l+1] = '\0';
        if(row == 0)
            direction = 1;
        else if(row == rows - 1)
            direction = -1;
        row = row + direction;
    }
    printf("Output: ");
    for(i = 0; i < rows; i++)
        printf("%s", arr[i]);
    return 0;
}

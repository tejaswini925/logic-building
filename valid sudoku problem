#include <stdio.h>

int main() {
    int a[9][9], i, j, k;
    printf("Enter 9x9 Sudoku:\n");
    for(i=0;i<9;i++)
        for(j=0;j<9;j++)
            scanf("%d",&a[i][j]);
    for(i=0;i<9;i++)
        for(j=0;j<9;j++)
            for(k=j+1;k<9;k++)
                if(a[i][j]==a[i][k]) {
                    printf("Invalid Sudoku");
                    return 0;
                }
    for(i=0;i<9;i++)
        for(j=0;j<9;j++)
            for(k=j+1;k<9;k++)
                if(a[j][i]==a[k][i]) {
                    printf("Invalid Sudoku");
                    return 0;
                }
    printf("Valid Sudoku");
    return 0;
}
